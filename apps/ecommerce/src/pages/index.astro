---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  
  <!-- Fonts Matching Reference Design: Montserrat for impact, Plus Jakarta Sans for UI, Caveat for Script -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Montserrat:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    :root {
      /* Dark Theme & Gold Palette extracted directly from assets-references/imagenes/imagen001.jpg */
      --bg-main: #070708;
      --bg-darker: #000000;
      --bg-surface: #121214;
      --bg-surface-card: #141417;
      --bg-surface-hover: #1c1c20;
      --border-subtle: #242429;
      --border-highlight: #ffb703;
      
      --text-heading: #ffffff;
      --text-body: #d1d5db;
      --text-muted: #9ca3af;
      
      /* Vibrant Amber Gold / Mustard Yellow */
      --color-gold: #ffb703;
      --color-gold-hover: #f59e0b;
      --color-gold-dark: #b45309;
      --color-gold-glow: rgba(255, 183, 3, 0.28);
      
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-pill: 9999px;
      
      --shadow-card: 0 10px 25px -5px rgba(0, 0, 0, 0.6), 0 8px 10px -6px rgba(0, 0, 0, 0.4);
      --shadow-gold: 0 8px 24px rgba(255, 183, 3, 0.35);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-main);
      color: var(--text-body);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* Top Navigation Bar */
    .header-nav {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(7, 7, 8, 0.94);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      transition: all 0.3s ease;
    }

    .nav-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      text-decoration: none;
    }

    .brand-icon-box {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, #ffb703, #f59e0b);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.55rem;
      box-shadow: 0 4px 14px rgba(255, 183, 3, 0.35);
    }

    .brand-text-wrap {
      display: flex;
      flex-direction: column;
    }

    .brand-name {
      font-family: 'Montserrat', sans-serif;
      font-size: 1.35rem;
      font-weight: 900;
      color: #ffffff;
      letter-spacing: 0.02em;
      line-height: 1.1;
    }

    .brand-name span {
      color: var(--color-gold);
    }

    .brand-slogan {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #a1a1aa;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      gap: 2.2rem;
      list-style: none;
    }

    .nav-menu a {
      text-decoration: none;
      color: #e5e7eb;
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      position: relative;
      padding: 0.4rem 0;
      transition: color 0.2s ease;
    }

    .nav-menu a:hover, .nav-menu a.active {
      color: var(--color-gold);
    }

    .nav-menu a.active::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--color-gold);
      border-radius: 2px;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .btn-portal {
      background: rgba(255, 255, 255, 0.07);
      color: #e5e7eb;
      border: 1px solid rgba(255, 255, 255, 0.14);
      padding: 0.6rem 1.1rem;
      border-radius: var(--radius-pill);
      font-size: 0.82rem;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      transition: all 0.2s ease;
    }

    .btn-portal:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--color-gold);
      color: #ffffff;
      transform: translateY(-1px);
    }

    .btn-order-online {
      background: var(--color-gold);
      color: #000000;
      padding: 0.65rem 1.4rem;
      border-radius: var(--radius-pill);
      font-size: 0.88rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 4px 16px rgba(255, 183, 3, 0.35);
      transition: all 0.2s ease;
    }

    .btn-order-online:hover {
      background: var(--color-gold-hover);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255, 183, 3, 0.5);
    }

    /* Hero Section */
    .hero-wrapper {
      position: relative;
      background: radial-gradient(circle at 75% 45%, rgba(255, 183, 3, 0.15) 0%, rgba(255, 183, 3, 0.04) 40%, transparent 70%), #070708;
      padding: 4.5rem 1.5rem 6.5rem;
      overflow: hidden;
    }

    .hero-container {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
      align-items: center;
      position: relative;
      z-index: 2;
    }

    .hero-script-tag {
      font-family: 'Caveat', cursive;
      font-size: 2.2rem;
      font-weight: 700;
      color: var(--color-gold);
      display: block;
      margin-bottom: 0.2rem;
      letter-spacing: 0.02em;
    }

    .hero-title-main {
      font-family: 'Montserrat', sans-serif;
      font-size: 4.2rem;
      font-weight: 900;
      text-transform: uppercase;
      line-height: 1.05;
      letter-spacing: -0.01em;
      color: #ffffff;
      margin-bottom: 1.4rem;
    }

    .hero-title-main .gold-text {
      color: var(--color-gold);
      display: block;
    }

    .hero-desc {
      font-size: 1.12rem;
      color: #9ca3af;
      max-width: 520px;
      line-height: 1.65;
      margin-bottom: 2.2rem;
    }

    .hero-btn-row {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-bottom: 3.2rem;
      flex-wrap: wrap;
    }

    .btn-hero-primary {
      background: var(--color-gold);
      color: #000000;
      padding: 0.95rem 2.2rem;
      border-radius: var(--radius-pill);
      font-size: 1rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      box-shadow: 0 8px 24px rgba(255, 183, 3, 0.4);
      transition: all 0.25s ease;
    }

    .btn-hero-primary:hover {
      background: var(--color-gold-hover);
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(255, 183, 3, 0.55);
    }

    .btn-watch-video {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      color: #ffffff;
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: all 0.2s ease;
    }

    .play-circle {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 2px solid rgba(255, 255, 255, 0.4);
      background: rgba(255, 255, 255, 0.05);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
      color: var(--color-gold);
      transition: all 0.2s ease;
    }

    .btn-watch-video:hover .play-circle {
      border-color: var(--color-gold);
      background: var(--color-gold);
      color: #000000;
      transform: scale(1.08);
    }

    .btn-watch-video:hover {
      color: var(--color-gold);
    }

    /* Features Strip below Hero buttons */
    .hero-features-bar {
      display: flex;
      gap: 2rem;
      padding-top: 1.8rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      flex-wrap: wrap;
    }

    .hero-feat-item {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .feat-icon-gold {
      font-size: 1.6rem;
      color: var(--color-gold);
      flex-shrink: 0;
    }

    .feat-text-box h5 {
      font-size: 0.88rem;
      font-weight: 800;
      text-transform: uppercase;
      color: #ffffff;
      letter-spacing: 0.04em;
    }

    .feat-text-box p {
      font-size: 0.78rem;
      color: #9ca3af;
    }

    /* Hero Right Visual */
    .hero-visual-side {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hero-burger-art {
      position: relative;
      width: 100%;
      max-width: 490px;
      filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.85));
      transition: transform 0.5s ease;
    }

    .hero-burger-art:hover {
      transform: scale(1.02);
    }

    .hero-burger-art img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 24px;
    }

    /* 100% Fresh Ingredients Badge */
    .hero-seal-badge {
      position: absolute;
      top: 12%;
      left: -8%;
      width: 110px;
      height: 110px;
      background: #000000;
      border: 3px solid var(--color-gold);
      border-radius: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0.5rem;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.8), 0 0 15px rgba(255, 183, 3, 0.35);
      animation: sealFloat 4s ease-in-out infinite alternate;
      z-index: 5;
    }

    @keyframes sealFloat {
      0% { transform: translateY(0) rotate(-4deg); }
      100% { transform: translateY(-8px) rotate(4deg); }
    }

    .seal-percent {
      font-family: 'Montserrat', sans-serif;
      font-size: 1.25rem;
      font-weight: 900;
      color: var(--color-gold);
      line-height: 1;
    }

    .seal-label {
      font-size: 0.58rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #ffffff;
      line-height: 1.1;
      margin-top: 2px;
    }

    /* Floating White Category Bar */
    .categories-section {
      max-width: 1240px;
      margin: -3rem auto 3rem;
      padding: 0 1.5rem;
      position: relative;
      z-index: 30;
    }

    .category-white-card {
      background: #ffffff;
      border-radius: var(--radius-lg);
      padding: 1.5rem 1rem;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.7);
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 1rem;
    }

    .category-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 0.8rem 0.5rem;
      border-radius: 14px;
      text-decoration: none;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .category-item:hover, .category-item.active {
      background: #fef3c7;
      transform: translateY(-3px);
    }

    .category-icon {
      font-size: 2.2rem;
      margin-bottom: 0.45rem;
      transition: transform 0.2s;
    }

    .category-item:hover .category-icon {
      transform: scale(1.15);
    }

    .category-name {
      font-family: 'Montserrat', sans-serif;
      font-size: 0.88rem;
      font-weight: 900;
      text-transform: uppercase;
      color: #111827;
      letter-spacing: 0.04em;
    }

    .category-sub {
      font-size: 0.72rem;
      font-weight: 600;
      color: #6b7280;
      margin-top: 0.15rem;
    }

    /* Bestsellers Section */
    .bestsellers-section {
      max-width: 1240px;
      margin: 0 auto;
      padding: 4rem 1.5rem;
    }

    .section-title-wrap {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .popular-picks-script {
      font-family: 'Caveat', cursive;
      font-size: 1.85rem;
      font-weight: 700;
      color: var(--color-gold);
      letter-spacing: 0.04em;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 0.35rem;
    }

    .popular-picks-script::before, .popular-picks-script::after {
      content: '';
      display: inline-block;
      width: 50px;
      height: 1px;
      background: rgba(255, 183, 3, 0.4);
    }

    .section-headline {
      font-family: 'Montserrat', sans-serif;
      font-size: 2.5rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #ffffff;
    }

    /* Filter Buttons */
    .filter-pills-row {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }

    .filter-pill {
      background: #141417;
      border: 1px solid #27272a;
      color: #a1a1aa;
      padding: 0.55rem 1.35rem;
      border-radius: var(--radius-pill);
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .filter-pill.active, .filter-pill:hover {
      background: var(--color-gold);
      color: #000000;
      border-color: var(--color-gold);
