  <!-- Interactive Logic -->
  <script>
    // Category pills filter
    const filterButtons = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.product-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // White floating category items filter
    const categoryItems = document.querySelectorAll('.category-item');
    categoryItems.forEach(item => {
      item.addEventListener('click', () => {
        categoryItems.forEach(i => i.classList.remove('active'));
        item.classList.add('active');

        const targetCat = item.getAttribute('data-cat');
        cards.forEach(card => {
          const cardCat = card.getAttribute('data-catname');
          if (cardCat && cardCat.toLowerCase().includes(targetCat.toLowerCase())) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        // Scroll to catalog smoothly
        const catalogEl = document.getElementById('catalogo');
        if (catalogEl) {
          catalogEl.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Details Modal
    const modal = document.getElementById('detailModal');
    const closeBtn = document.getElementById('closeModalBtn');
    const openBtns = document.querySelectorAll('.open-modal-btn');

    const modalImg = document.getElementById('modalImg');
    const modalBadge = document.getElementById('modalBadge');
    const modalTitle = document.getElementById('modalTitle');
    const modalLevel = document.getElementById('modalLevel');
    const modalDesc = document.getElementById('modalDesc');
    const modalPrepTime = document.getElementById('modalPrepTime');
    const modalCals = document.getElementById('modalCals');
    const modalHighlight = document.getElementById('modalHighlight');
    const modalIngredients = document.getElementById('modalIngredients');
    const modalPrice = document.getElementById('modalPrice');

    openBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const name = btn.getAttribute('data-name');
        const badge = btn.getAttribute('data-badge');
        const level = btn.getAttribute('data-level');
        const price = btn.getAttribute('data-price');
        const image = btn.getAttribute('data-image');
        const desc = btn.getAttribute('data-description');
        const cals = btn.getAttribute('data-calories');
        const preptime = btn.getAttribute('data-preptime');
        const highlight = btn.getAttribute('data-highlight');
        let ingredients = [];
        try {
          ingredients = JSON.parse(btn.getAttribute('data-ingredients') || '[]');
        } catch(e) {
          ingredients = [];
        }

        modalImg.src = image;
        modalBadge.textContent = badge;
        modalTitle.textContent = name;
        modalLevel.textContent = level;
        modalDesc.textContent = desc;
        modalPrepTime.textContent = preptime;
        modalCals.textContent = cals;
        modalHighlight.textContent = highlight;
        modalPrice.textContent = `$${price}`;

        modalIngredients.innerHTML = '';
        ingredients.forEach(ing => {
          const chip = document.createElement('span');
          chip.className = 'ingredient-chip-dark';
          chip.textContent = ing;
          modalIngredients.appendChild(chip);
        });

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    const closeModal = () => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    };

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  </script>
